{
  "name": "pizzablitz",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "extract": "node scripts/extract-menu.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "db:generate": "npm run generate --workspace backend",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend"
  }
}
